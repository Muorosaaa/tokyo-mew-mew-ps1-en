{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "deny": [
      "WebFetch(domain:tcrf.net)"
    ]
  },
  "extraKnownMarketplaces": {
    "retro-translation-extended": {
      "source": {
        "source": "github",
        "repo": "Muorosaaa/translate-retro-game-extended"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "translate-retro-game@retro-translation-extended": true,
    "translate-retro-game@retro-translation": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/muras/.claude/plugins/marketplaces/retro-translation-extended/skills/translate-retro-game/scripts/hooks/guard_bash.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"print('Context was reset. Before continuing, re-read AGENTS.md (or CLAUDE.md) and docs/status.md; resume from the next item there.')\""
          }
        ]
      }
    ]
  }
}
